{
	"openapi": "3.1.0",
	"info": {
		"title": "Contract API",
		"version": "1.0.0",
		"description": "A stable public contract fixture."
	},
	"paths": {
		"/widgets/{id}": {
			"post": {
				"operationId": "updateWidget",
				"summary": "Update a widget",
				"description": "Updates one widget.",
				"tags": [
					"widgets"
				],
				"security": [
					{
						"bearerAuth": []
					}
				],
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"description": "Widget identifier",
						"required": true,
						"schema": {
							"type": "integer",
							"format": "int64",
							"description": "Widget identifier"
						}
					},
					{
						"name": "limit",
						"in": "query",
						"schema": {
							"type": "integer",
							"format": "int64",
							"default": 20,
							"minimum": 1,
							"maximum": 100
						}
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/publicContractRequest"
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/publicContractResponse"
								}
							}
						}
					},
					"400": {
						"description": "Bad Request",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/publicContractProblem"
								}
							}
						}
					}
				}
			}
		}
	},
	"components": {
		"schemas": {
			"publicContractProblem": {
				"type": "object",
				"properties": {
					"message": {
						"type": "string"
					}
				},
				"required": [
					"message"
				]
			},
			"publicContractRequest": {
				"type": "object",
				"properties": {
					"name": {
						"type": "string",
						"minLength": 1,
						"maxLength": 100
					}
				},
				"required": [
					"name"
				]
			},
			"publicContractResponse": {
				"type": "object",
				"properties": {
					"id": {
						"type": "integer",
						"format": "int64"
					},
					"name": {
						"type": "string"
					}
				},
				"required": [
					"id"
				]
			}
		},
		"securitySchemes": {
			"bearerAuth": {
				"type": "http",
				"scheme": "bearer",
				"bearerFormat": "JWT"
			}
		}
	}
}
