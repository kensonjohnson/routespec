{
	"openapi": "3.1.0",
	"info": {
		"title": "Contract API",
		"version": "1.0.0",
		"description": "A stable public contract fixture.",
		"termsOfService": "https://example.com/terms",
		"contact": {
			"name": "Contract team",
			"email": "api@example.com"
		},
		"license": {
			"name": "Apache 2.0",
			"identifier": "Apache-2.0"
		}
	},
	"servers": [
		{
			"url": "https://{environment}.example.com/v1",
			"variables": {
				"environment": {
					"enum": [
						"api",
						"staging"
					],
					"default": "api"
				}
			}
		}
	],
	"paths": {
		"/widgets/{id}": {
			"post": {
				"operationId": "updateWidget",
				"summary": "Update a widget",
				"description": "Updates one widget.",
				"tags": [
					"widgets"
				],
				"security": [
					{
						"bearerAuth": []
					}
				],
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"description": "Widget identifier",
						"required": true,
						"schema": {
							"type": "integer",
							"format": "int64",
							"description": "Widget identifier"
						}
					},
					{
						"name": "limit",
						"in": "query",
						"schema": {
							"type": "integer",
							"format": "int64",
							"default": 20,
							"minimum": 1,
							"maximum": 100
						}
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/publicContractRequest"
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/publicContractResponse"
								}
							}
						},
						"links": {
							"self": {
								"operationId": "updateWidget"
							}
						}
					},
					"400": {
						"description": "Bad Request",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/publicContractProblem"
								}
							}
						}
					}
				}
			}
		}
	},
	"tags": [
		{
			"name": "widgets",
			"description": "Widget operations.",
			"externalDocs": {
				"url": "https://example.com/docs/widgets"
			}
		}
	],
	"externalDocs": {
		"description": "Integration guide.",
		"url": "https://example.com/docs"
	},
	"components": {
		"schemas": {
			"publicContractProblem": {
				"type": "object",
				"properties": {
					"message": {
						"type": "string"
					}
				},
				"required": [
					"message"
				]
			},
			"publicContractRequest": {
				"type": "object",
				"properties": {
					"name": {
						"type": "string",
						"minLength": 1,
						"maxLength": 100
					}
				},
				"required": [
					"name"
				]
			},
			"publicContractResponse": {
				"type": "object",
				"properties": {
					"id": {
						"type": "integer",
						"format": "int64"
					},
					"name": {
						"type": "string"
					}
				},
				"required": [
					"id"
				]
			}
		},
		"securitySchemes": {
			"apiKeyAuth": {
				"type": "apiKey",
				"name": "X-API-Key",
				"in": "header"
			},
			"bearerAuth": {
				"type": "http",
				"scheme": "bearer",
				"bearerFormat": "JWT"
			},
			"mtlsAuth": {
				"type": "mutualTLS"
			},
			"oauthAuth": {
				"type": "oauth2",
				"flows": {
					"authorizationCode": {
						"authorizationUrl": "https://example.com/authorize",
						"tokenUrl": "https://example.com/token",
						"scopes": {
							"widgets:write": "Update widgets"
						}
					}
				}
			},
			"oidcAuth": {
				"type": "openIdConnect",
				"openIdConnectUrl": "https://example.com/.well-known/openid-configuration"
			}
		}
	}
}
